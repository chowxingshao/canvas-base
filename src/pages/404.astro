---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../lib/config/site.ts';
import { getUi } from '../lib/i18n/ui.ts';
import { getEntryLocale } from '../lib/content/entries.ts';
import { getRouteManifest } from '../lib/routing/manifest.ts';
const locale = getSiteConfig().i18n.defaultLocale;
const entry = (await getCollection('pages')).find(
  (entry) =>
    entry.data.slug === 'not-found' &&
    !entry.data.draft &&
    getEntryLocale(entry) === locale,
);
if (!entry) throw new Error('A published not-found page is required.');
const { Content } = await render(entry);
const ui = await getUi(locale);
const home = (await getRouteManifest()).find(
  (route) =>
    route.kind === 'page' && route.slug === 'home' && route.locale === locale,
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  noindex
>
  <article class="page-content shell" lang={locale}>
    <header class="page-intro">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {home && (
      <p>
        <a href={home.path}>{ui.notFound.returnHome}</a>
      </p>
    )}
  </article>
</BaseLayout>
