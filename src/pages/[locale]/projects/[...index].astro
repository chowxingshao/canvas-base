---
import PageView from '../../../components/PageView.astro';
import { getRouteManifest } from '../../../lib/routing/manifest.ts';
import { getSiteConfig } from '../../../lib/config/site.ts';
import type { RouteRecord } from '../../../lib/routing/types.ts';
export async function getStaticPaths() {
  return (await getRouteManifest())
    .filter(
      (route) =>
        route.kind === 'project-index' &&
        route.locale !== getSiteConfig().i18n.defaultLocale,
    )
    .map((route) => ({
      params: { locale: route.locale, index: undefined },
      props: { route },
    }));
}
interface Props {
  route: RouteRecord;
}
const { route } = Astro.props;
---

<PageView route={route} />
