---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getSiteConfig } from '../lib/config/site.ts';
import { getUi } from '../lib/i18n/ui.ts';
import { getRouteManifest } from '../lib/routing/manifest.ts';
import { enabledLocales } from '../lib/routing/paths.ts';
import type { RouteRecord } from '../lib/routing/types.ts';
interface Props {
  locale: string;
  current?: RouteRecord;
}
const { locale, current } = Astro.props;
const site = getSiteConfig();
const ui = await getUi(locale);
const routes = (await getRouteManifest()).filter(
  (route) => route.locale === locale,
);
const home = routes.find(
  (route) => route.kind === 'page' && route.slug === 'home',
);
const links = [
  { route: home, label: ui.nav.home },
  {
    route: routes.find(
      (route) => route.kind === 'page' && route.slug === 'about',
    ),
    label: ui.nav.about,
  },
  {
    route: routes.find((route) => route.kind === 'post-index'),
    label: ui.nav.blog,
  },
  {
    route: routes.find((route) => route.kind === 'project-index'),
    label: ui.nav.projects,
  },
  {
    route: routes.find(
      (route) => route.kind === 'page' && route.slug === 'contact',
    ),
    label: ui.nav.contact,
  },
];
const locales = enabledLocales(site);
---

<header class="site-header shell">
  {home ? (
    <a class="site-name" href={home.path}>
      {site.name}
    </a>
  ) : (
    <span class="site-name">{site.name}</span>
  )}
  <nav aria-label={ui.accessibility.primaryNavigation}>
    <ul class="nav-list">
      {links.map(
        ({ route, label }) =>
          route && (
            <li>
              <a
                href={route.path}
                aria-current={current?.path === route.path ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ),
      )}
    </ul>
  </nav>
  {current && locales.length > 1 && (
    <LanguageSwitcher current={current} locales={locales} />
  )}
</header>
