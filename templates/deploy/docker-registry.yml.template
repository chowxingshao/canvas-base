name: Publish Docker image
on:
  push:
    tags: ['v*']
permissions:
  contents: read
jobs:
  verify:
    uses: ./.github/workflows/ci.yml
  publish:
    needs: verify
    runs-on: ubuntu-latest
    environment: production
    permissions:
      contents: read
      packages: write
    steps:
      - name: Download verified image
        uses: actions/download-artifact@v7
        with:
          name: site-image
          path: .verified-image
      - name: Load verified image
        run: docker load --input .verified-image/site-image.tar
      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Publish version and latest
        env:
          RELEASE_TAG: ${{ github.ref_name }}
        run: |
          if [[ ! "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "Only stable vMAJOR.MINOR.PATCH tags may publish."
            exit 1
          fi
          image="ghcr.io/${GITHUB_REPOSITORY,,}"
          docker tag canvas-base-ci:verified "$image:$RELEASE_TAG"
          docker tag canvas-base-ci:verified "$image:latest"
          docker push "$image:$RELEASE_TAG"
          docker push "$image:latest"
