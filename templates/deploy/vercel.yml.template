name: Deploy to Vercel
on:
  pull_request:
    branches: ['{{BRANCH}}']
  push:
    branches: ['{{BRANCH}}']
permissions:
  contents: read
jobs:
  verify:
    uses: ./.github/workflows/ci.yml
  deploy:
    needs: verify
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    environment: production
    steps:
      - uses: actions/download-artifact@v7
        with: { name: site-vercel, path: .vercel/output }
      - run: npx --yes vercel@50.11.0 deploy --prebuilt --prod --yes --token="$VERCEL_TOKEN" --meta canvasGithubEvent=push --meta canvasGithubRepository="$GITHUB_REPOSITORY"
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
  preview:
    needs: verify
    if: github.event_name == 'pull_request' && vars.ENABLE_PREVIEWS == 'true' && github.event.pull_request.head.repo.full_name == github.repository && needs.verify.result == 'success'
    runs-on: ubuntu-latest
    environment: preview
    permissions:
      contents: read
      pull-requests: write
    concurrency:
      group: vercel-preview-${{ github.event.pull_request.number }}
      cancel-in-progress: true
    steps:
      - name: Require established production push
        id: bootstrap
        uses: actions/github-script@v8
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
        with:
          script: |
            for (const key of ['VERCEL_TOKEN', 'VERCEL_ORG_ID', 'VERCEL_PROJECT_ID', 'GITHUB_REPOSITORY']) {
              if (!process.env[key]) throw new Error('Missing Vercel production bootstrap configuration: ' + key);
            }
            const url = new URL('https://api.vercel.com/v7/deployments');
            url.search = new URLSearchParams({
              projectId: process.env.VERCEL_PROJECT_ID,
              teamId: process.env.VERCEL_ORG_ID,
              target: 'production', state: 'READY', limit: '100',
            }).toString();
            const response = await fetch(url, {
              headers: { Authorization: 'Bearer ' + process.env.VERCEL_TOKEN },
              redirect: 'error', signal: AbortSignal.timeout(10000),
            });
            if (!response.ok) throw new Error('Vercel production bootstrap check failed: HTTP ' + response.status);
            const data = await response.json();
            if (!Array.isArray(data.deployments)) throw new Error('Invalid Vercel production bootstrap response.');
            const established = data.deployments.some(deployment =>
              deployment.projectId === process.env.VERCEL_PROJECT_ID &&
              deployment.target === 'production' && deployment.readyState === 'READY' &&
              deployment.meta?.canvasGithubEvent === 'push' &&
              deployment.meta?.canvasGithubRepository === process.env.GITHUB_REPOSITORY &&
              !deployment.meta?.githubPrId);
            if (!established) {
              throw new Error('Bootstrap Vercel with a successful production push before enabling PR previews.');
            }
      - uses: actions/download-artifact@v7
        with: { name: site-vercel, path: .vercel/output }
      - name: Deploy verified preview
        id: publish
        run: |
          url="$(npx --yes vercel@50.11.0 deploy --prebuilt --yes --token="$VERCEL_TOKEN")"
          printf 'url=%s\n' "$url" >> "$GITHUB_OUTPUT"
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
          VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
          VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
      - name: Post or update preview URL
        uses: actions/github-script@v8
        env:
          PREVIEW_URL: ${{ steps.publish.outputs.url }}
        with:
          script: |
            const url = new URL(process.env.PREVIEW_URL);
            if (url.protocol !== 'https:' || url.username || url.password) {
              throw new Error('Expected an HTTPS preview URL without credentials.');
            }
            const marker = '<!-- canvas-preview:vercel -->';
            const body = marker + '\nPreview: ' + process.env.PREVIEW_URL;
            const comments = await github.paginate(github.rest.issues.listComments, {
              ...context.repo, issue_number: context.issue.number,
            });
            const existing = comments.find(comment =>
              comment.user?.login === 'github-actions[bot]' && comment.body?.includes(marker));
            if (existing) {
              await github.rest.issues.updateComment({
                ...context.repo, comment_id: existing.id, body,
              });
            } else {
              await github.rest.issues.createComment({
                ...context.repo, issue_number: context.issue.number, body,
              });
            }
